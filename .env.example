# Copy this file to .env and fill in YOUR OWN key. Never commit .env!
# Inside Docker, pass these with -e or --env-file instead.

# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Cheap model for attach, strong model for repair (plan section 7)
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_STRONG=gpt-5

# Stop calling the model once this many dollars are spent in total (per data folder)
LLM_BUDGET_USD=5
# 1 = cache identical prompts on disk (free reruns while developing)
LLM_CACHE=1

# How often every portal is re-read
REFRESH_MINUTES=15
