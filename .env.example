# Copy this file to .env and fill in your keys. Never commit .env!

# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# ElevenLabs key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Which OpenAI model to use
OPENAI_MODEL=gpt-5-mini

# Which ElevenLabs voice to use (find more IDs in the ElevenLabs voice library)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 = cheap while building, eleven_multilingual_v2 = best quality and good Dutch
ELEVENLABS_MODEL=eleven_flash_v2_5
